[Unit]
Description=Fall detection L4 - local API, voice check, alerts, kiosk page
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/fall-detect-system
EnvironmentFile=-/home/pi/fall-detect-system/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/fall-detect-system/.venv/bin/python -m l4_application.server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
